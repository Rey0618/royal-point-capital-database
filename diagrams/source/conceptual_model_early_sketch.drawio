<mxfile host="app.diagrams.net">
  <diagram id="conceptual" name="Conceptual model">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Royal Point Capital: conceptual model" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="CLIENT" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="portfolio" value="PORTFOLIO" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="manager" value="PORTFOLIO MANAGER" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cashflow" value="CASH FLOW" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="360" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="trade" value="TRADE" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="360" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="security" value="SECURITY" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="600" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="broker" value="BROKER" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="880" y="600" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Rule 1: PORTFOLIO MANAGER 1 manages 0..* PORTFOLIO -->
        <mxCell id="e1" value="manages" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="manager" target="portfolio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1s" value="1" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e1t" value="0..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Rule 2: CLIENT 1..* owns 1..* PORTFOLIO (many-to-many, circled) -->
        <mxCell id="mn" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="95" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mnlabel" value="many-to-many" style="text;html=1;fontSize=11;fontColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="165" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="owns" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="portfolio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2s" value="1..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e2t" value="1..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Rule 3a: PORTFOLIO 1 records 0..* TRADE -->
        <mxCell id="e3" value="records" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="portfolio" target="trade">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3s" value="1" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e3">
          <mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e3t" value="0..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e3">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint x="18" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Rule 3b: SECURITY 1 is traded in 0..* TRADE -->
        <mxCell id="e4" value="is traded in" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="security" target="trade">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4s" value="1" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e4">
          <mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="-14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e4t" value="0..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e4">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint x="-18" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Rule 4: BROKER 1 executes 0..* TRADE -->
        <mxCell id="e5" value="executes" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="broker" target="trade">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5s" value="1" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e5t" value="0..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint x="18" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Rule 5a: CLIENT 1 makes 0..* CASH FLOW -->
        <mxCell id="e6" value="makes" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="cashflow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6s" value="1" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="-14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e6t" value="0..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint x="-18" as="offset"/></mxGeometry>
        </mxCell>

        <!-- Rule 5b: PORTFOLIO 1 receives 0..* CASH FLOW -->
        <mxCell id="e7" value="receives" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="portfolio" target="cashflow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7s" value="1" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint x="14" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e7t" value="0..*" style="edgeLabel;html=1;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="0.75" relative="1" as="geometry"><mxPoint x="18" as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;1 = exactly one&lt;br&gt;0..* = zero or more&lt;br&gt;1..* = one or more&lt;br&gt;Dashed circle = many-to-many" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="200" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
